# 5: <http://mapping.example.com/map_frequencies_0> -> <http://mapping.example.com/map_trips_0>
CONSTRUCT 
  { 
    ?v7 <http://vocab.gtfs.org/terms#trip> ?s1_v4 .
  }
WHERE
  { { SELECT  ?jc0 ?v7
      WHERE
        { SERVICE <https://w3id.org/aksw/norse#rml.source>
            { <https://w3id.org/aksw/norse#rml.source>
                        a                     <http://semweb.mmlab.be/ns/rml#LogicalSource> ;
                        <http://semweb.mmlab.be/ns/rml#referenceFormulation>  <http://semweb.mmlab.be/ns/ql#CSV> ;
                        <http://semweb.mmlab.be/ns/rml#source>  "FREQUENCIES.csv" ;
                        <https://w3id.org/aksw/norse#rml.output>  ?s0}
          BIND(<https://w3id.org/aksw/norse#json.getStrict>(?s0, "trip_id") AS ?jc0)
          FILTER bound(?jc0)
          BIND(<https://w3id.org/aksw/norse#json.getStrict>(?s0, "start_time") AS ?v3)
          BIND(IRI(concat("http://transport.linkeddata.es/madrid/metro/frequency/", encode_for_uri(str(<https://w3id.org/aksw/norse#json.getStrict>(?s0, "trip_id"))), "-", encode_for_uri(str(?v3)))) AS ?v7)
        }
      LIMIT   9223372036854775807
    }
    { SELECT  ?jc0 ?s1_v4
      WHERE
        { SERVICE <https://w3id.org/aksw/norse#rml.source>
            { <https://w3id.org/aksw/norse#rml.source>
                        a                     <http://semweb.mmlab.be/ns/rml#LogicalSource> ;
                        <http://semweb.mmlab.be/ns/rml#referenceFormulation>  <http://semweb.mmlab.be/ns/ql#CSV> ;
                        <http://semweb.mmlab.be/ns/rml#source>  "TRIPS.csv" ;
                        <https://w3id.org/aksw/norse#rml.output>  ?s1}
          BIND(<https://w3id.org/aksw/norse#json.getStrict>(?s1, "trip_id") AS ?jc0)
          FILTER bound(?jc0)
          BIND(IRI(concat("http://transport.linkeddata.es/madrid/metro/trips/", encode_for_uri(str(<https://w3id.org/aksw/norse#json.getStrict>(?s1, "trip_id"))))) AS ?s1_v4)
        }
      LIMIT   9223372036854775807
    }
  }

