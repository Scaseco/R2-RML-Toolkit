                  <https://w3id.org/aksw/norse#rml.output>  ?s0}
    BIND(<https://w3id.org/aksw/norse#rml.iri>(concat("http://transport.linkeddata.es/madrid/metro/frequency/", encode_for_uri(str(<https://w3id.org/aksw/norse#json.getStrict>(?s0, "trip_id"))), "-", encode_for_uri(str(<https://w3id.org/aksw/norse#json.getStrict>(?s0, "start_time"))))) AS ?v7)
